{
  "FASTAPI_BASE_URL": "http://localhost:8000",
  "RPC_METADATA_ENDPOINT": "/api/rpcs",
  "STREAM_METADATA_ENDPOINT": "/api/streams",
  "camera": {
    "id": "window1_ximea_camera"
  },
  "stage": {
    "axes": ["Y", "Z", "Piezo"],
    "unit": "mm", 
    "id": "prototome_stage"
  },
  "video_streams": ["new_frame", "camera_lasso"],
  "axis_variable_mapping":{
    "pt_stage_fine": {
      "axis1": ["retract_piezo_distance"]
    },
    "pt_stage_coarse": {
      "axis2": [
        "bottom_position_mm",
        "ep_cut_bottom",
        "ep_cut_top",
        "top_position_mm"
      ],
      "axis1": ["retract_distance"]
    }
  }
}
